*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# =======================================================
# TODO: IMPLEMENT YOUR IPTABLES RULES BELOW
# =======================================================

# --- 1. ALLOW ESTABLISHED & RELATED TRAFFIC ---
-A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
-A FORWARD -m state --state ESTABLISHED,RELATED -j ACCEPT

-P FORWARD DROP
# --- 2. BLACKLIST / THREAT MITIGATION ---
-A INPUT -s 172.16.1.200 -j DROP

# --- 3. LAN TO DMZ & WAN ACCESS ---
-A INPUT -i eth1 -o eth2 -m state --state NEW -j ACCEPT
-A INPUT -i eth1 -o eth3 -m state --state NEW -j ACCEPT

# --- 4. WAN TO DMZ ACCESS ---
-A INPUT -s 172.16.1.100 -p tcp --dport 80 -j ACCEPT
-A INPUT -s 172.16.1.100 -p tcp --dport 443 -j ACCEPT

-A INPUT -s 172.16.1.100 -j DROP

COMMIT
